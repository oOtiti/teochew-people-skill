{
  "name": "teochew-people-skill",
  "version": "0.2.0",
  "description": "Teochew People (潮汕人) writing and review skill for AI agents.",
  "license": "MIT",
  "author": "oOtiti",
  "homepage": "https://github.com/oOtiti/teochew-people-skill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oOtiti/teochew-people-skill.git"
  },
  "bugs": {
    "url": "https://github.com/oOtiti/teochew-people-skill/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "teochew-people-skill": "scripts/install-skill.mjs"
  },
  "files": [
    "skills/teochew-people-skill",
    "scripts/install-skill.mjs",
    "examples",
    "assets/social-preview.png",
    "assets/case-demo.svg",
    "docs/github-workflows.md",
    "docs/publishing.md",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "install:codex": "node scripts/install-skill.mjs --codex --force",
    "install:claude": "node scripts/install-skill.mjs --claude --force",
    "wiki:index": "node skills/teochew-people-skill/scripts/build-index.mjs",
    "wiki:index:check": "node skills/teochew-people-skill/scripts/build-index.mjs --check",
    "wiki:lint": "node skills/teochew-people-skill/scripts/lint-wiki.mjs",
    "wiki:status": "node skills/teochew-people-skill/scripts/wiki-status.mjs",
    "test:scenarios": "node scripts/validate-scenarios.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "validate": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/validate-skill.ps1",
    "test": "npm run test:scenarios && npm run test:unit && npm run wiki:index:check && npm run wiki:lint && npm run validate",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "agent-skill",
    "codex-skill",
    "claude-code-skill",
    "chaoshan",
    "teochew",
    "teochew-people",
    "潮汕",
    "潮汕人",
    "潮汕文化",
    "中文写作"
  ],
  "engines": {
    "node": ">=18"
  }
}
